{
  "name": "@fungi.computer/cloudflare-computer",
  "version": "0.2.1-fungi.2",
  "author": "Levi <levi@technomancy.dev>",
  "description": "Fork of Cloudflare Computer 0.2.1 (@cloudflare/computer) with persisted worker-shell state",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fungi-computer/Botanical.git",
    "directory": "forks/cloudflare-computer"
  },
  "private": false,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./git": {
      "types": "./dist/git.d.ts",
      "import": "./dist/git.js"
    },
    "./assets": {
      "types": "./dist/assets/index.d.ts",
      "import": "./dist/assets/index.js"
    },
    "./artifacts": {
      "types": "./dist/artifacts/index.d.ts",
      "import": "./dist/artifacts/index.js"
    },
    "./tools": {
      "types": "./dist/tools/index.d.ts",
      "import": "./dist/tools/index.js"
    },
    "./backends/container": {
      "types": "./dist/backends/container/index.d.ts",
      "import": "./dist/backends/container/index.js"
    },
    "./backends/worker-javascript": {
      "types": "./dist/backends/worker-javascript/index.d.ts",
      "import": "./dist/backends/worker-javascript/index.js"
    },
    "./backends/worker-shell": {
      "types": "./dist/backends/worker-shell/index.d.ts",
      "import": "./dist/backends/worker-shell/index.js"
    },
    "./shell/core": {
      "types": "./dist/backends/worker-shell/shell/core.d.ts",
      "default": "./dist/backends/worker-shell/shell/core.js"
    },
    "./shell/curl": {
      "types": "./dist/backends/worker-shell/shell/curl.d.ts",
      "default": "./dist/backends/worker-shell/shell/curl.js"
    },
    "./shell/html-to-markdown": {
      "types": "./dist/backends/worker-shell/shell/html-to-markdown.d.ts",
      "default": "./dist/backends/worker-shell/shell/html-to-markdown.js"
    },
    "./shell/python": {
      "types": "./dist/backends/worker-shell/shell/python.d.ts",
      "default": "./dist/backends/worker-shell/shell/python.js"
    },
    "./shell/sqlite": {
      "types": "./dist/backends/worker-shell/shell/sqlite.d.ts",
      "default": "./dist/backends/worker-shell/shell/sqlite.js"
    },
    "./shell/js-exec": {
      "types": "./dist/backends/worker-shell/shell/js-exec.d.ts",
      "default": "./dist/backends/worker-shell/shell/js-exec.js"
    },
    "./shell/yq": {
      "types": "./dist/backends/worker-shell/shell/yq.d.ts",
      "default": "./dist/backends/worker-shell/shell/yq.js"
    },
    "./shell/file": {
      "types": "./dist/backends/worker-shell/shell/file.d.ts",
      "default": "./dist/backends/worker-shell/shell/file.js"
    },
    "./shell/xan": {
      "types": "./dist/backends/worker-shell/shell/xan.d.ts",
      "default": "./dist/backends/worker-shell/shell/xan.js"
    },
    "./shell/jq": {
      "types": "./dist/backends/worker-shell/shell/jq.d.ts",
      "default": "./dist/backends/worker-shell/shell/jq.js"
    },
    "./observe/cloudflare": {
      "types": "./dist/observe/cloudflare.d.ts",
      "import": "./dist/observe/cloudflare.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "clean": "node --input-type=module --eval \"import { rm } from 'node:fs/promises'; await rm('dist', { recursive: true, force: true });\"",
    "build:shell-bundle": "node ./src/backends/worker-shell/script/build-bundle.mjs",
    "build": "pnpm run clean && pnpm run build:shell-bundle && rolldown -c",
    "test": "node --test test/packed-file-names.test.mjs",
    "typecheck": "pnpm run build:shell-bundle && tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "acorn": "8.18.0",
    "@fungi.computer/capnweb": "workspace:*",
    "just-bash": "3.4.2"
  },
  "peerDependencies": {
    "@platformatic/vfs": "*",
    "ai": "^6.0.196 || ^7.0.0",
    "zod": "^4.4.3"
  },
  "peerDependenciesMeta": {
    "@platformatic/vfs": {
      "optional": true
    },
    "ai": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260730.1",
    "@platformatic/vfs": "0.4.0",
    "@types/node": "25.9.5",
    "ai": "7.0.42",
    "diff": "9.0.0",
    "esbuild": "0.28.1",
    "isomorphic-git": "1.40.0",
    "just-bash-shell-bundle": "npm:just-bash@3.2.0",
    "rolldown": "1.2.1",
    "rolldown-plugin-dts": "0.25.2",
    "typescript": "6.0.3",
    "zod": "4.4.3"
  },
  "fungi": {
    "build": {
      "script": "build"
    }
  },
  "botanical": {
    "role": "package",
    "operations": {
      "lint": {
        "status": "not-applicable",
        "reason": "Upstream Cloudflare Computer source; repository lint skips forks/** like other vendored source"
      },
      "typecheck": "required",
      "build": "required",
      "test": {
        "status": "required"
      },
      "docs": {
        "status": "not-applicable",
        "reason": "Upstream Cloudflare Computer documents this API; the fork adds no documentation surface"
      },
      "pack": {
        "status": "not-applicable",
        "reason": "Publication of the fork is a separate approval"
      },
      "smoke": {
        "status": "not-applicable",
        "reason": "packages/computer runtime-proof exercises the built package in workerd"
      },
      "stranger": {
        "status": "not-applicable",
        "reason": "Publication of the fork is a separate approval"
      }
    }
  }
}
